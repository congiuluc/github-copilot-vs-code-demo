@TodoApi_HostAddress = http://localhost:5255

### Get all todos
GET {{TodoApi_HostAddress}}/api/todos
Accept: application/json

###

### Create a new todo
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "Learn ASP.NET Core",
  "description": "Complete the todo API implementation"
}

###

### Create another todo
POST {{TodoApi_HostAddress}}/api/todos
Content-Type: application/json

{
  "title": "Write unit tests",
  "description": "Add comprehensive test coverage"
}

###

### Get a specific todo by ID
GET {{TodoApi_HostAddress}}/api/todos/1
Accept: application/json

###

### Update a todo
PUT {{TodoApi_HostAddress}}/api/todos/1
Content-Type: application/json

{
  "title": "Learn ASP.NET Core - Updated",
  "description": "Complete the todo API implementation with best practices",
  "isCompleted": false
}

###

### Toggle todo completion
PATCH {{TodoApi_HostAddress}}/api/todos/1/toggle
Accept: application/json

###

### Filter completed todos
GET {{TodoApi_HostAddress}}/api/todos/filter?completed=true
Accept: application/json

###

### Search todos
GET {{TodoApi_HostAddress}}/api/todos/filter?search=learn
Accept: application/json

###

### Delete a todo
DELETE {{TodoApi_HostAddress}}/api/todos/1
Accept: application/json

###
